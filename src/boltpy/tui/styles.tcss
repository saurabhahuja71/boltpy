Screen { background: $background; color: $text; }
#main { height: 1fr; padding: 0; }
#command-suggestions { display: none; height: 1; color: $primary; padding: 0 1; text-overflow: ellipsis; }
#content { height: 1fr; }
#transcript { width: 1fr; height: 1fr; border: none; background: $surface; padding: 0 1; scrollbar-color: $text-disabled; }
#footer-status { height: 1; width: 100%; }
#status { width: 100%; height: 1; color: $text-muted; padding: 0 1; }
#footer-meta { height: 1; width: 100%; padding: 0 1; color: $text-muted; }
#workspace { width: 1fr; text-overflow: ellipsis; }
#task-time { width: auto; text-align: right; }
#prompt { height: 4; min-height: 3; max-height: 8; border: round $success; background: $panel; padding: 0 1; }

#todo-panel { width: 30; height: auto; min-height: 3; max-height: 12; margin-left: 1; border: round $border; background: $surface; padding: 1 1; overflow-y: auto; }

.system-message { padding: 0 1 0 0; height: auto; margin-bottom: 1; }
.assistant-streaming { height: auto; margin: 0 0 1 0; padding: 0 1; border: none; }

.tool-activity { height: auto; padding: 0 1; margin-bottom: 1; }
.tool-card { height: auto; padding: 0 1; }
.tool-args { height: auto; color: $text; text-style: bold; }
.tool-status { height: 1; }
.tool-status-success { color: $success; }
.tool-status-warning { color: $warning; }
.tool-status-error { color: $error; }
.tool-result { height: auto; color: $text-muted; }

#permission-prompt { display: none; width: 100%; height: auto; max-height: 7; padding: 0 1; margin: 0; border: none; background: transparent; }
#permission-content { width: 100%; height: auto; }
#permission-title { height: 1; text-style: bold; color: $warning; }
#permission-tool { height: 1; text-style: bold; }
#permission-details { height: auto; max-height: 2; padding: 0; color: $text; overflow-y: auto; }
#permission-buttons { height: 1; width: 100%; layout: horizontal; align: left middle; }
#permission-buttons Button { width: auto; min-width: 0; height: 1; margin: 0 1 0 0; padding: 0 1; border: none; text-style: bold; }
#permission-buttons Button:hover { background: $primary-darken-1; color: $text; border: none; }
#permission-buttons Button:focus { background: $primary; color: $foreground; border: none; text-style: bold underline; }
#permission-buttons #allow-once:focus { background: $success; }
#permission-buttons #allow-session:focus { background: $primary; }
#permission-buttons #allow-permanent:focus { background: $warning; }
#permission-buttons #deny:focus { background: $error; }
#permission-help { height: 1; color: $text-muted; padding: 0; }

#model-prompt { display: none; width: 100%; height: auto; max-height: 12; padding: 1 2; margin: 0 1; border: round $primary; background: $panel; }
#model-content { width: 100%; height: auto; }
#model-title { height: 1; text-style: bold; color: $primary; }
#model-options { height: auto; max-height: 7; padding: 0 1; border: none; }
#model-options:focus { border: round $primary; }
#model-help { height: 1; color: $text-muted; padding-top: 1; }

#options-prompt { display: none; width: 100%; height: auto; max-height: 14; padding: 1 2; margin: 0 1; border: round $accent; background: $panel; }
#options-content { width: 100%; height: auto; }
#options-title { height: 1; text-style: bold; color: $accent; }
#options-list { height: auto; max-height: 8; padding: 0 1; border: none; }
#options-list:focus { border: round $accent; }
#options-custom { display: none; height: 3; margin-top: 1; border: round $border; }
#options-help { height: 1; color: $text-muted; padding-top: 1; }

Collapsible { border: none; height: auto; }
Collapsible > .collapsible--header { color: $text; text-style: bold; }
